{
  "name": "ohmycontext",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first personal AI context layer",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "tsx apps/cli/src/index.ts",
    "ui": "tsx apps/cli/src/index.ts ui",
    "clean": "pnpm -r exec rm -rf dist .tsup"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
